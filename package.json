{
  "name": "Sedimind",
  "version": "2.0.0",
  "description": "Obsidian 插件：通过 LLM 对话控制 Obsidian，实现笔记创建、编辑、搜索等功能",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs --sync && git add manifest.json versions.json package.json",
    "release": "node version-bump.mjs",
    "finalize": "node version-bump.mjs --finalize"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "llm",
    "chat",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.5.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "marked": "^12.0.0",
    "tslib": "^2.8.1"
  }
}
